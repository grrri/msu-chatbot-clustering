        "def cluster_finder(labels, texts):\n",
        "  length = len(list(set(labels)))\n",
        "  result = [[] for _ in range(length)]\n",
        "  for i, text in enumerate(texts):\n",
        "    result[labels[i]].append(text)\n",
        "  return result"
      ],
      "metadata": {
        "id": "UaiguN1Z94Ay"
      },
      "execution_count": null,
      "outputs": []
